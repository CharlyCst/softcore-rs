+                        -rust
+                        # Input files.
+                        ${sail_srcs}
+                )
+
+                add_custom_target(generated_rust_${arch} DEPENDS /tmp/raw-${arch}.rs)
+
                 add_custom_command(
                     DEPENDS ${sail_srcs}
